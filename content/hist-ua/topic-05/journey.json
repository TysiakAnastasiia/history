        {
          "who": "olherd",
          "text": "Татарські царики не змогли довго витримати натиску. Київщина, Чернігівщина, Переяславщина й Поділля тепер — Литві."
        }
      ],
      "ask": {
        "text": "Кого переміг Ольгерд на Синіх Водах?",
        "options": [
          {
            "text": "Золоту Орду",
            "correct": true,
            "reply": "Так! Це 1362 р."
          },
          {
            "text": "Тевтонський орден",
            "reply": "Це Грюнвальд 1410 р."
          },
          {
            "text": "Московську армію",
            "reply": "Це Орша 1514 р."
          }
        ]
      },
      "outro": [
        {
          "who": "guide",
          "text": "Старого не змінювати, нового не впроваджувати — таким був принцип литовської політики."
        }
      ],
      "reward": {
        "name": "Литовський стяг",
        "about": "1362 р.: Ольгерд приєднав Київщину, Чернігівщину, Переяславщину, Поділля."
