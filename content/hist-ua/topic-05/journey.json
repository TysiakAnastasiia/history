      "character": "lubart",
      "lines": [
        {
          "who": "guide",
          "text": "Волинь, 1340 рік. Після смерті Юрія II Болеслава всі ласо дивляться на Галицько-Волинську спадщину."
        },
        {
          "who": "lubart",
          "text": "Я Любарт, зять Юрія I. Волинь буде моєю, а от Галичиною ще доведеться поборотися з поляками…"
        }
      ],
      "ask": {
        "text": "Чим закінчилася піввікова боротьба за Галицько-Волинську спадщину?",
        "options": [
          {
            "text": "Розподілом земель: Галичина — Польща, Волинь — Литва",
            "correct": true,
            "reply": "Так! Польща взяла Галичину, Литва — Волинь."
          },
          {
            "text": "Усі землі дісталися Литві",
            "reply": "Галичину здобула Польща."
          },
          {
            "text": "Усі землі дісталися Угорщині",
            "reply": "Угорці приєднали лише Перемишль."
          }
        ]
      },
      "outro": [
        {
          "who": "guide",
          "text": "1434 р. Польща створила Руське воєводство, Литва — Волинське князівство."
        }
      ],
      "reward": {
        "name": "Волинська печатка",
        "about": "Любарт і боротьба за Галицько-Волинську спадщину."
